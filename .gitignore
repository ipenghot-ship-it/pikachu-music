# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# canvaskit-wasm：本地 dev 时由 node_modules/canvaskit-wasm 提供，**必须**进 git
# 否则 `expo export --platform web` 产物里没有这个 wasm，Tauri WebView 拉不到 /canvaskit.wasm
# CanvasKit init 失败 → Skia Canvas 渲染成黑色蒙版盖全屏
# 若 canvaskit-wasm 升级到不同版本，重新 cp 后提交即可：
#   cp node_modules/canvaskit-wasm/bin/full/canvaskit.wasm public/canvaskit.wasm
# public/canvaskit.wasm  ← 不再忽略

# Legacy code backup (cloned from a webpage before this project was rewritten as React Native)
# Keep local-only for reference; not pushed to GitHub. Delete after project stabilizes.
legacy-clone/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Release signing
android/app/release.keystore
android/app/.keystore.env

# Tauri
# src-tauri/target/ 编译产物几百 MB，git 忽略
# src-tauri/gen/    Tauri 生成的 schemas，build 时自动重建
src-tauri/target/
src-tauri/gen/

# Expo + Tauri 协调
# 之前 legacy-clone 备份 public/canvaskit.wasm 都在 .gitignore 里
